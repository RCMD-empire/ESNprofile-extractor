{
  "manifest_version": 3,
  "name": "ESN Profile Extractor",
  "version": "1.0.0",
  "description": "Extract ESN profile details from the currently open authenticated profile page and copy them as an Excel-compatible row.",
  "icons": {
    "16": "extension_logo.png",
    "32": "extension_logo.png",
    "48": "extension_logo.png",
    "128": "extension_logo.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://accounts.esn.org/*"
      ],
      "js": [
        "lib/selectors.js",
        "content/extractor.js",
        "content/profile-urler.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ESN Profile Extractor",
    "default_icon": {
      "16": "extension_logo.png",
      "32": "extension_logo.png",
      "48": "extension_logo.png"
    },
    "default_popup": "popup.html"
  }
}
